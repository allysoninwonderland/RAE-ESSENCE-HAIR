PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

SESSION_SECRET=change-this-to-a-long-random-string

ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replaceWithBcryptHashOfYourRealPassword

# Optional: without these, new-order/new-booking emails are silently skipped.
# Get an API key from https://resend.com (API Keys tab).
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=info.raeessence@gmail.com

# Optional: point at a hosted Turso database (libsql://...) for production.
# Left unset, a local SQLite file under data/ is used instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
